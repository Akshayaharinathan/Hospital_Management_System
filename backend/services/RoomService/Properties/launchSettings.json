{
    "$schema": "http://json.schemastore.org/launchsettings.json",
    "profiles": {
        "http": {
            "commandName": "Project",
            "launchBrowser": true,
            "launchUrl": "swagger",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "PatientService__BaseUrl": "http://localhost:5265"
            },
            "dotnetRunMessages": true,
            "applicationUrl": "http://localhost:5045"
        },
        "https": {
            "commandName": "Project",
            "launchBrowser": true,
            "launchUrl": "swagger",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "PatientService__BaseUrl": "http://localhost:5265" // if your patient service is HTTPS
            },
            "dotnetRunMessages": true,
            "applicationUrl": "https://localhost:7272;http://localhost:5045"
        }
    },
    "iisSettings": {
        "windowsAuthentication": false,
        "anonymousAuthentication": true,
        "iisExpress": {
            "applicationUrl": "http://localhost:62482",
            "sslPort": 44318
        }
    }
}
